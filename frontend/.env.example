# Questo file documenta le variabili attese, ma il file .env reale va creato
# nella root del repository: Vite lo legge tramite envDir: "..".
# Non creare un secondo file .env dentro frontend/.

# URL base del backend Spring Boot usata dal client Axios.
VITE_API_BASE_URL=http://localhost:8080

# Chiave pubblica MapTiler usata da MapLibre per la basemap di Discover.
# Crea una chiave su https://cloud.maptiler.com/ e limita i domini autorizzati.
VITE_MAPTILER_KEY=
