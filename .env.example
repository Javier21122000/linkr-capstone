# Copia questo file in .env e inserisci i tuoi valori locali.
# .env NON deve mai essere committato (e' gia' nel .gitignore).
LINKR_DB_URL=jdbc:postgresql://localhost:5432/linkr_db
LINKR_DB_USERNAME=
LINKR_DB_PASSWORD=

# Segreto per firmare i JWT (OBBLIGATORIO, almeno 32 caratteri). Generarlo con: openssl rand -base64 48
LINKR_JWT_SECRET=
# Durata del token (opzionale, default 2h)
# LINKR_JWT_EXPIRATION=2h

# Nome del database che il backend accetta (default: linkr_db). Cambiarlo solo se il database ha un altro nome, es. in produzione.
# LINKR_DB_EXPECTED_NAME=linkr_db

# Origini del frontend autorizzate da CORS, separate da virgola (opzionale in locale)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cartella ESTERNA al repository dove il backend salva le immagini caricate (opzionale).
# Default: ~/.linkr/uploads. Non puo' stare dentro la copia di lavoro di Git: il backend si rifiuta di partire.
# LINKR_UPLOAD_DIR=/percorso/assoluto/fuori/dal/repository

# --- Frontend (letti da Vite al momento della build/avvio, non da Spring Boot) ---
# Chiave MapTiler per mappa e ricerca luoghi. E' PUBBLICA (finisce nel bundle): restringerla all'origine del sito dal pannello MapTiler.
# VITE_MAPTILER_KEY=
# Cartografia di Discover: di base LINKR alleggerisce lo stile MapTiler lato client (niente edifici 3D, negozi, benzinai, parcheggi, etichette di mezzo mondo).
# `full` ripristina lo stile MapTiler completo, senza toccare il codice. Lo stile condiviso su MapTiler non viene mai modificato.
# VITE_MAP_STYLE=full
# URL dell'API solo se NON e' sullo stesso dominio del sito (REST, immagini e WebSocket la seguono). Con il proxy di Vite o un reverse proxy: vuota.
# VITE_API_BASE_URL=
